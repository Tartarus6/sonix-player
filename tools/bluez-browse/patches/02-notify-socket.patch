+#ifndef BLUEZ_SRC_CLIENT_H
+#define BLUEZ_SRC_CLIENT_H
+
+#include <sys/socket.h>
+#include <sys/un.h>
+
+/* Unix datagram notification channel used by the HiBy system client. */
+#define SYS_CLIENT_SOCKET "/var/run/sys_client"
+
+int client_open(const char *path, struct sockaddr_un *addr);
+int client_send(int fd, const char *msg, const void *addr, socklen_t len);
+int client_close(int fd);
+int client_send_msg(const char *path, const char *msg);
+int client_send_msg_2client(const char *msg);
+
+#endif /* BLUEZ_SRC_CLIENT_H */
