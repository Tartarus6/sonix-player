+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+#include "src/log.h"
+#include "src/client.h"
+
+int client_open(const char *path, struct sockaddr_un *addr)
+{
+	int fd;
+
+	fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+	if (fd < 0) {
+		error("client: Could not create socket");
+		return -1;
+	}
+
+	memset(addr, 0, sizeof(*addr));
+	addr->sun_family = AF_UNIX;
+	snprintf(addr->sun_path, sizeof(addr->sun_path), "%s",
+						path != NULL ? path : SYS_CLIENT_SOCKET);
+
+	if (connect(fd, (struct sockaddr *) addr, sizeof(*addr)) < 0) {
+		error("client: Could not connect to %s", addr->sun_path);
+		close(fd);
+		return -2;
+	}
+
+	return fd;
+}
+
+int client_send(int fd, const char *msg, const void *addr, socklen_t len)
+{
+	ssize_t n;
+
+	if (msg == NULL)
+		return -EINVAL;
+
+	n = send(fd, msg, strlen(msg), 0);
+	if (n < 0) {
+		error("client: Could not send message");
+		return -1;
+	}
+
+	return (int) n;
+}
+
+int client_close(int fd)
+{
+	if (fd >= 0)
+		close(fd);
+
+	return 0;
+}
+
+int client_send_msg(const char *path, const char *msg)
+{
+	struct sockaddr_un addr;
+	int fd;
+
+	fd = client_open(path, &addr);
+	if (fd <= 0)
+		return -1;
+
+	client_send(fd, msg, &addr, sizeof(addr));
+	client_close(fd);
+
+	return 0;
+}
+
+int client_send_msg_2client(const char *msg)
+{
+	return client_send_msg(SYS_CLIENT_SOCKET, msg);
+}
