+int avctp_send_browsing_rsp(struct avctp *session, uint8_t transaction,
+				uint8_t *operands, size_t operand_count)
+{
+	struct avctp_channel *browsing;
+	struct avctp_queue *queue;
+
+	if (session == NULL || session->browsing == NULL)
+		return -ENOTCONN;
+
+	browsing = session->browsing;
+	queue = g_slist_nth_data(browsing->queues, 0);
+	if (queue == NULL)
+		return -ENOTCONN;
+
+	return avctp_browsing_send(queue, transaction, AVCTP_RESPONSE,
+							operands, operand_count);
+}
